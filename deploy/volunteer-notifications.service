[Unit]
Description=MyChurch volunteer notification worker
After=network-online.target stpauls-site.service
Wants=network-online.target

[Service]
Type=oneshot
User=mychurch
EnvironmentFile=-/var/www/mychurch/.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 55 -X POST -H "Authorization: Bearer ${VOLUNTEER_NOTIFICATION_WORKER_SECRET}" http://127.0.0.1:3000/api/events/rotation-notifications/process-internal
