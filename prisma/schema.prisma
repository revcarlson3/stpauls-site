generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  viewer
  editor
  admin
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageRevisionKind {
  MANUAL
  AUTOSAVE
}

enum Permission {
  ACCESS_ADMIN
  EDIT_PAGES
  PUBLISH_PAGES
  MANAGE_MENUS
  MANAGE_USERS
  MANAGE_SETTINGS
  MANAGE_MEMBERSHIP
  MANAGE_EVENTS
  MANAGE_GIVING
  MANAGE_ACCOUNTING
  MANAGE_SERVICES
  MANAGE_MODULES
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String?
  isActive Boolean @default(true)
  emailVerifiedAt DateTime?
  failedLoginAttempts Int      @default(0)
  loginWindowStartedAt DateTime?
  lockedUntil DateTime?
  sessionVersion Int @default(0)
  mfaEnabled Boolean @default(false)
  mfaSecretEncrypted String?
  mfaRecoveryCodesEncrypted String?
  mfaEnrolledAt DateTime?
  emailMfaEnabled Boolean @default(false)
  smsMfaEnabled Boolean @default(false)
  phoneNumber String? @unique
  phoneVerifiedAt DateTime?
  memberProfile MemberProfile?
  verificationTokens EmailVerificationToken[]
  emailChangeTokens EmailChangeToken[]
  passwordResetTokens PasswordResetToken[]
  role         Role           @default(viewer)
  groupId      String?
  group        SecurityGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  revisions    PageRevision[] @relation("RevisionAuthor")
  published    Page[]         @relation("PublishedBy")
  invitations  UserInvitation[] @relation("InvitationCreator")
  auditLogs    AuditLog[] @relation("AuditActor")
  mfaChallenges MfaChallenge[]
  membershipNotes MembershipNote[] @relation("MembershipNoteAuthor")
  membershipMessageTemplates MembershipMessageTemplate[] @relation("MembershipMessageTemplateAuthor")
  membershipMessages MembershipMessage[] @relation("MembershipMessageAuthor")
  volunteerAssignmentChanges MembershipVolunteerAssignment[] @relation("VolunteerAssignmentActor")
  uploadedMedia MediaAsset[] @relation("UploadedMedia")
}

model MfaChallenge {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel String
  purpose String @default("login")
  recipient String
  codeHash String
  expiresAt DateTime
  attempts Int @default(0)
  lastSentAt DateTime @default(now())
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, channel, purpose, expiresAt])
  @@index([userId, consumedAt])
}

model AuditLog {
  id String @id @default(cuid())
  activityType String
  summary String
  details String?
  actorId String?
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([activityType, createdAt])
  @@index([createdAt])
}

model EmailChangeToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model UserInvitation {
  id String @id @default(cuid())
  email String
  name String
  role Role @default(viewer)
  groupId String?
  group SecurityGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdById String
  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([email, expiresAt])
}

model SecuritySettings {
  id                   Int      @id @default(1)
  loginProtectionEnabled Boolean @default(true)
  maxFailedAttempts   Int      @default(5)
  lockoutMinutes      Int      @default(15)
  captchaMode      String   @default("off")
  emailMfaEnabled  Boolean  @default(false)
  smsMfaEnabled    Boolean  @default(false)
  authenticatorMfaEnabled Boolean @default(false)
  recaptchaSiteKey String?
  recaptchaSecretEncrypted String?
  smsProvider String @default("twilio")
  smsAccountId String?
  smsAuthSecretEncrypted String?
  smsFrom String?
  totpIssuer String @default("St. Paul's Site")
  mfaChallengePolicy String @default("every-login")
  trustedDeviceDays Int @default(30)
  minPasswordLength Int @default(12)
  passwordRequireUppercase Boolean @default(true)
  passwordRequireLowercase Boolean @default(true)
  passwordRequireNumber Boolean @default(true)
  passwordRequireSymbol Boolean @default(true)
  passwordExcludeAmbiguous Boolean @default(true)
  smtpHost          String?
  smtpPort          Int      @default(587)
  smtpUser          String?
  smtpPasswordEncrypted String?
  emailProvider     String   @default("smtp")
  emailApiKeyEncrypted String?
  emailApiSecretEncrypted String?
  emailApiDomain    String?
  emailApiRegion    String?
  emailFrom         String?
  registrationCodeEncrypted String?
  pollinationsApiKeyEncrypted String?
  enabledModules Json @default("[]")
  membershipAgeCategories Json @default("[\"Infant\",\"Toddler\",\"Preschool\",\"Elementary\",\"Youth\",\"Young Adult\",\"Adult\",\"Senior\"]")
  publicSiteEnabled Boolean @default(true)
  siteName           String  @default("St. Paul's")
  siteUrl            String  @default("")
  siteTagline        String  @default("A place to belong.")
  siteLogoUrl        String  @default("")
  siteLogoLightUrl   String  @default("")
  siteLogoDarkUrl    String  @default("")
  siteFaviconUrl     String  @default("")
  siteShowTitle      Boolean @default(true)
  siteShowTagline    Boolean @default(true)
  siteShowLogo       Boolean @default(false)
  themeFamily       String   @default("bootstrap")
  themeWidth        String   @default("full")
  themeBackground   String   @default("#f8f4ee")
  themeForeground   String   @default("#17324d")
  themeAccent       String   @default("#e66f51")
  themeSurface      String   @default("#ffffff")
  themeButtonPrimary String  @default("#e66f51")
  themeButtonSecondary String @default("#17324d")
  themeButtonDefault String @default("#ffffff")
  themeNotificationPrimary String @default("#e66f51")
  themeNotificationSecondary String @default("#17324d")
  themeNotificationDefault String @default("#ffffff")
  themeNotificationSuccess String @default("#2f855a")
  themeNotificationWarning String @default("#b7791f")
  themeNotificationDanger String @default("#c53030")
  themeNotificationInfo String @default("#287c8c")
  themeHeadingFont  String   @default("Lora")
  themeBodyFont     String   @default("Inter")
  themeRadius       String   @default("balanced")
  themeElevation    String   @default("soft")
  themeButton       String   @default("pill")
  themeNav          String   @default("minimal")
  themeSpacing      String   @default("comfortable")
  themeContentBorder Boolean  @default(true)
  membershipMessageRecipientLimit Int @default(200)
  headerConfig      Json     @default("{}")
  footerConfig      Json     @default("{}")
  updatedAt         DateTime @updatedAt
}

model MembershipGradeAdvancementRun {
  id           String   @id @default(cuid())
  schoolYear   Int      @unique
  updatedCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model SecurityGroup {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  users       User[]
  invitations UserInvitation[]
  permissions GroupPermission[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model GroupPermission {
  groupId    String
  permission Permission
  group      SecurityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, permission])
}

model Page {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  seoTitle          String?
  seoDescription    String?
  seoKeywords       String?
  status            PageStatus    @default(DRAFT)
  isHome            Boolean       @default(false)
  blocks            Json
  menuId            String?
  menu              Menu?         @relation(fields: [menuId], references: [id], onDelete: SetNull)
  revisions         PageRevision[]
  publishedAt       DateTime?
  publishAt         DateTime?
  pageThemeFamily   String?
  pageThemeWidth    String?
  showHeader        Boolean       @default(true)
  showFooter        Boolean       @default(true)
  fullScreen        Boolean       @default(false)
  passwordHash      String?
  publishedById     String?
  publishedBy       User?         @relation("PublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
}

model Widget {
  id        String   @id @default(cuid())
  name      String
  type      String
  area      String   @default("sidebar")
  config    Json
  position  Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([area, position])
  @@index([enabled])
}

model Form {
  id                   String           @id @default(cuid())
  name                 String
  slug                 String           @unique
  status               String           @default("DRAFT")
  enabled              Boolean          @default(true)
  definition           Json
  notificationSettings Json             @default("{}")
  exportSettings       Json             @default("{}")
  submissions          FormSubmission[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status, enabled])
  @@index([updatedAt])
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  values      Json
  metadata    Json     @default("{}")
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([formId, createdAt])
  @@index([createdAt])
}

model MediaAsset {
  id             String   @id @default(cuid())
  originalName   String
  storedFilename String   @unique
  url            String   @unique
  mimeType       String
  sizeBytes      Int
  folder         String   @default("unfiled")
  caption        String?
  description    String?
  width          Int?
  height         Int?
  altText        String?
  title          String?
  tags           String[] @default([])
  uploaderId     String?
  uploader       User?    @relation("UploadedMedia", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
  @@index([mimeType])
  @@index([uploaderId])
  @@index([folder])
}

model MemberProfile {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String   @unique
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  DECEASED
  REMOVED
}

enum MembershipGender {
  MALE
  FEMALE
}

enum MembershipCustomFieldType {
  TEXT
  TEXTAREA
  SELECT
  RADIO
  CHECKBOX
  DATE
  PHONE
  EMAIL
}

model MembershipFamily {
  id                 String           @id @default(cuid())
  lastName           String
  familyNameOverride String?
  formalGreeting     String?
  informalGreeting   String?
  addressStreet      String?
  addressCity        String?
  addressState       String?
  addressZip         String?
  secondaryStreet    String?
  secondaryCity      String?
  secondaryState     String?
  secondaryZip       String?
  secondaryIsMailing Boolean          @default(false)
  phone              String?
  phoneIsMobile      Boolean          @default(false)
  email              String?
  photographUrl      String?
  status             MembershipStatus  @default(ACTIVE)
  removedAt          DateTime?
  individuals        MembershipIndividual[]
  customValues       MembershipCustomFieldValue[]
  documents          MembershipDocument[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([lastName, status])
}

model MembershipIndividual {
  id                  String           @id @default(cuid())
  familyId            String
  family              MembershipFamily @relation(fields: [familyId], references: [id], onDelete: Restrict)
  memberTypeId        String
  memberType          MembershipMemberType @relation(fields: [memberTypeId], references: [id], onDelete: Restrict)
  familyRoleId        String
  familyRole          MembershipFamilyRole @relation(fields: [familyRoleId], references: [id], onDelete: Restrict)
  firstName           String
  middleName          String?
  lastName            String?
  birthday            DateTime
  ageCategoryOverride String?
  cellphone           String?
  otherPhone          String?
  otherPhoneType      String?
  email               String?
  emailMessagesAllowed Boolean         @default(false)
  smsMessagesAllowed   Boolean         @default(false)
  memberNumber         Int              @unique
  gradeLevel          String?
  maritalStatus       String
  weddingDate         DateTime?
  deceasedDate        DateTime?
  gender              MembershipGender
  status              MembershipStatus @default(ACTIVE)
  removedAt           DateTime?
  customValues        MembershipCustomFieldValue[]
  notes               MembershipNote[]
  messageRecipients   MembershipMessageRecipient[]
  volunteerGroups     MembershipVolunteerGroupMember[]
  volunteerAssignmentHistory MembershipVolunteerAssignment[]
  manualLists         MembershipManualListMember[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([familyId, status])
  @@index([lastName, firstName])
}

model MembershipFamilyRole {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  individuals  MembershipIndividual[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model MembershipMemberType {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  position     Int                   @default(0)
  individuals  MembershipIndividual[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model MembershipVolunteerGroup {
  id          String                           @id @default(cuid())
  name        String
  description String?
  slug        String                           @unique
  position    Int                              @default(0)
  members     MembershipVolunteerGroupMember[]
  assignmentHistory MembershipVolunteerAssignment[]
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
}

model MembershipVolunteerGroupMember {
  groupId      String
  individualId String
  role         String?
  isLeader     Boolean  @default(false)
  availability Json?
  skills       String?
  group        MembershipVolunteerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  individual   MembershipIndividual     @relation(fields: [individualId], references: [id], onDelete: Cascade)
  assignedAt   DateTime                  @default(now())

  @@id([groupId, individualId])
  @@index([individualId])
  @@index([groupId, isLeader])
}

model MembershipManualList {
  id          String                         @id @default(cuid())
  name        String
  description String?
  slug        String                         @unique
  members     MembershipManualListMember[]
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
}

model MembershipManualListMember {
  listId       String
  individualId String
  list         MembershipManualList @relation(fields: [listId], references: [id], onDelete: Cascade)
  individual   MembershipIndividual @relation(fields: [individualId], references: [id], onDelete: Cascade)
  assignedAt   DateTime             @default(now())

  @@id([listId, individualId])
  @@index([individualId])
}

model MembershipDynamicList {
  id          String   @id @default(cuid())
  name        String
  description String?
  slug        String   @unique
  criteria    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MembershipVolunteerAssignment {
  id           String                    @id @default(cuid())
  groupId      String
  individualId String
  action       String
  role         String?
  isLeader     Boolean?
  availability Json?
  skills       String?
  changedById  String?
  group        MembershipVolunteerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  individual   MembershipIndividual     @relation(fields: [individualId], references: [id], onDelete: Cascade)
  changedBy    User?                     @relation("VolunteerAssignmentActor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                  @default(now())

  @@index([groupId, createdAt])
  @@index([individualId, createdAt])
}

model MembershipCustomFieldDefinition {
  id          String                    @id @default(cuid())
  name        String
  slug        String                    @unique
  type        MembershipCustomFieldType
  appliesTo   String
  options     Json?
  isRequired  Boolean                   @default(false)
  isActive    Boolean                   @default(true)
  position    Int                       @default(0)
  values      MembershipCustomFieldValue[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([appliesTo, isActive, position])
}

model MembershipCustomFieldValue {
  id           String                           @id @default(cuid())
  definitionId String
  definition   MembershipCustomFieldDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  familyId     String?
  family       MembershipFamily?               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  individualId String?
  individual   MembershipIndividual?           @relation(fields: [individualId], references: [id], onDelete: Cascade)
  value        String
  updatedAt    DateTime                         @updatedAt

  @@unique([definitionId, familyId])
  @@unique([definitionId, individualId])
}

model MembershipNote {
  id           String                @id @default(cuid())
  individualId String
  individual   MembershipIndividual @relation(fields: [individualId], references: [id], onDelete: Cascade)
  authorId     String
  author       User                  @relation("MembershipNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reason       String
  body         String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([individualId, createdAt])
}

model MembershipDocument {
  id         String           @id @default(cuid())
  familyId   String
  family     MembershipFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  originalName String
  storageKey String           @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime         @default(now())
}

enum MembershipMessageChannel {
  EMAIL
  SMS
}

enum MembershipMessageStatus {
  STUBBED
  QUEUED
  SENT
  FAILED
}

model MembershipMessageTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  bodyHtml    String
  bodyText    String?
  createdById  String?
  createdBy   User?    @relation("MembershipMessageTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById, updatedAt])
}

model MembershipMessage {
  id             String                   @id @default(cuid())
  channel        MembershipMessageChannel
  subject        String?
  bodyHtml       String
  bodyText       String
  status         MembershipMessageStatus  @default(STUBBED)
  deliveryNote   String?
  createdById    String
  createdBy      User                     @relation("MembershipMessageAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  recipients     MembershipMessageRecipient[]
  attachments    MembershipMessageAttachment[]
  createdAt      DateTime                 @default(now())

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model MembershipMessageRecipient {
  id             String              @id @default(cuid())
  messageId      String
  message        MembershipMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  individualId   String
  individual     MembershipIndividual @relation(fields: [individualId], references: [id], onDelete: Restrict)
  address        String
  displayName    String
  eligibilityReason String?
  status         String              @default("PENDING")
  deliveredAt    DateTime?
  attemptCount   Int                 @default(0)
  lastAttemptAt  DateTime?
  failureReason  String?
  providerMessageId String?
  deliveryAttempts MembershipMessageDeliveryAttempt[]

  @@unique([messageId, individualId])
  @@index([individualId, status])
}

model MembershipMessageDeliveryAttempt {
  id          String                      @id @default(cuid())
  recipientId String
  recipient   MembershipMessageRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  status      String
  error       String?
  providerMessageId String?
  attemptedAt DateTime                    @default(now())

  @@index([recipientId, attemptedAt])
}

model MembershipMessageAttachment {
  id             String            @id @default(cuid())
  messageId      String
  message        MembershipMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  sizeBytes      Int
  contentBase64  String?
  createdAt      DateTime          @default(now())

  @@index([messageId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blocks    Json
  snapshot  Json?
  title     String
  kind      PageRevisionKind @default(MANUAL)
  authorId  String
  author    User     @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

model Menu {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  items     MenuItem[]
  pages     Page[]
  locations MenuLocation[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuLocation {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  menuId    String?
  menu      Menu?    @relation(fields: [menuId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        String    @id @default(cuid())
  menuId    String
  menu      Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label     String
  href      String
  itemType  String    @default("INTERNAL")
  openInNewTab Boolean @default(false)
  position  Int       @default(0)
  parentId  String?
  parent    MenuItem? @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("MenuTree")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([menuId, position])
}
